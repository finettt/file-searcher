# Embedding model
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=http://llamacpp:8000/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# OCR LLM (vision-capable model, separate key)
OCR_API_KEY=sk-xxx
OCR_LLM_BASE_URL=http://llamacpp-ocr:8000/v1
OCR_LLM_MODEL=qwen3.5-4b

# Absolute path to folder with files on host
DATA_DIR=/path/to/documents
FILEBROWSER_URL=http://localhost:8080
HIDE_HEALTH=1
